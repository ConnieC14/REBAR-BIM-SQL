# Copy to .env (repo root) and fill in. .env is git-ignored; never commit keys.
# The eval runner sets the database, retrieval and limits from each config
# (backend/evals/configs/*.yaml), so these mainly matter for the app.

# --- LLM ---
# "anthropic" (paid) or "ollama" (local, free: qwen2.5-coder:7b)
LLM_PROVIDER=ollama
# Always set a model; with no LLM_MODEL the anthropic default is claude-opus-5-5
LLM_MODEL=qwen2.5-coder:7b
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=
# Only for an OpenAI model added in backend/app_models.yaml
OPENAI_API_KEY=

# --- Database (Snowdon Towers, SQLite, built by backend/scripts/vim_to_sqlite.py) ---
# Read-only, like the eval runs; the relative path assumes you run from backend/
DB_URL=sqlite:///file:db/vim_samples/Snowdon.r2027.db?mode=ro&uri=true
CHROMA_DB_PATH=./chroma_db_snowdon
METADATA_SOURCE=files
EMBEDDING_PROVIDER=local

# --- Pipeline ---
# baseline | static_search | agentic_search | agentic_values | oracle
RETRIEVAL=agentic_values
MAX_STEPS=10
SQL_TIMEOUT_S=30
SQL_MAX_ROWS=200

# --- Optional: original WideWorldImporters setup (SQL Server in Docker) ---
# MSSQL_SA_PASSWORD=
# DB_URL_RESTRICTED_FAR_WEST=
